<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Target Name="ILRepacker" AfterTargets="Build">
        <ItemGroup>
            <!-- Merged in, so the plugin ships as a single DLL. -->
            <InputAssemblies Include="$(TargetPath)" />
            <InputAssemblies Include="$(OutputPath)ServerSync.dll" />
            <!-- ILRepack resolves the game and BepInEx assemblies from these folders. -->
            <ILRepackLibraryPath Include="$(OutputPath)" />
            <ILRepackLibraryPath Include="$(BepInExPath)/core" />
            <ILRepackLibraryPath Include="$(CorlibPath)" />
        </ItemGroup>
        <ILRepack Parallel="true" DebugInfo="true" Internalize="true" InputAssemblies="@(InputAssemblies)" OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="@(ILRepackLibraryPath)" />
    </Target>
</Project>
